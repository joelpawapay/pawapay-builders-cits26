# Copy this file to .env and fill in your token:  cp .env.example .env
# Never commit .env. It holds your API token.

PAWAPAY_API_TOKEN=paste-your-sandbox-token-here
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io

# Tags every transaction so you can find yours on the shared account.
PAWAPAY_TEAM=team-your-team-name
